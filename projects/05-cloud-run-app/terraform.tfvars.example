# Copy this file to terraform.tfvars locally and set your real values.
# Never commit terraform.tfvars to version control.
project_id = "your-project-id"

# Leave empty on the first apply. After pushing the image, set it and apply again.
image = ""
# image = "us-central1-docker.pkg.dev/your-project-id/apps/status-api:1.0.0"

allow_public_access = false
max_instances       = 2
